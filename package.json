{
	"name": "@md-oss/cftools.js",
	"version": "1.3.0",
	"description": "JavaScript implementation for the CFTools Data API.",
	"publishConfig": {
		"access": "public",
		"registry": "https://registry.npmjs.org/"
	},
	"type": "module",
	"main": "./dist/index.cjs",
	"module": "./dist/index.mjs",
	"types": "./dist/index.d.cts",
	"exports": {
		"require": {
			"types": "./dist/index.d.cts",
			"default": "./dist/index.cjs"
		},
		"import": {
			"types": "./dist/index.d.mts",
			"default": "./dist/index.mjs"
		}
	},
	"files": [
		"dist/**"
	],
	"scripts": {
		"clean:dist": "rimraf ./dist",
		"clean:modules": "rimraf ./node_modules",
		"clean": "npm run clean:dist && npm run clean:modules",
		"checks": "npx @biomejs/biome check --write",
		"dev": "npm run build:dev & npm run start:dev",
		"format": "npx @biomejs/biome format --write",
		"lint": "npx @biomejs/biome lint --write",
		"prebuild": "npm run clean:dist",
		"build": "pkgroll --minify --clean-dist --sourcemap --define.process.env.NODE_ENV='\"production\"' --define.DEBUG=false",
		"build:dev": "pkgroll --watch --define.process.env.NODE_ENV='\"development\"' --define.DEBUG=true",
		"build:docs": "rimraf ./docs && typedoc",
		"start": "node dist/index.mjs",
		"start:dev": "node --watch dist/index.mjs",
		"pretest": "npm run build",
		"prepublishOnly": "npm run build && npm run build:docs",
		"test": "mocha",
		"test:dev": "mocha --watch",
		"typecheck": "tsc --noEmit",
		"up:minor": "npx npm-check-updates@latest -u --target minor && npm install",
		"up:major": "npx npm-check-updates@latest -u --target latest && npm install"
	},
	"devDependencies": {
		"@biomejs/biome": "2.4.13",
		"@types/chai": "^5.2.3",
		"@types/mocha": "^10.0.10",
		"@types/node": "^25.6.0",
		"chai": "^6.2.2",
		"dotenv": "^17.4.2",
		"globals": "^17.5.0",
		"mocha": "^11.7.5",
		"pkgroll": "^2.27.0",
		"rimraf": "^6.1.3",
		"tsx": "^4.21.0",
		"typedoc": "^0.28.19",
		"typescript": "^5.9.3"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/Mirasaki-OSS/cftools.js.git"
	},
	"keywords": [
		"cftools",
		"cftools-sdk",
		"cftools-api",
		"cftools-data-api",
		"cftools-wrapper",
		"api-wrapper"
	],
	"author": {
		"name": "Mirasaki Development",
		"email": "info@mirasaki.dev",
		"url": "https://mirasaki.dev"
	},
	"license": "ISC",
	"bugs": {
		"url": "https://github.com/Mirasaki-OSS/cftools.js/issues"
	},
	"dependencies": {
		"cache-manager": "^7.2.8",
		"keyv": "^5.6.0",
		"lru-cache": "^11.3.5",
		"type-fest": "^5.6.0"
	}
}
